{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "Codice": {
      "type": "string"
    },
    "Price": {
      "type": "decimal"
    },
    "Stato": {
      "type": "enumeration",
      "enum": [
        "Ritirato",
        "In consegna",
        "Consegnato",
        "In attesa",
        "In arrivo"
      ]
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "orders"
    }
  }
}
